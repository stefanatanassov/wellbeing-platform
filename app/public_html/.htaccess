RewriteEngine On

# Canonicalize Shine Bright onto the dedicated www host.
RewriteCond %{HTTP_HOST} ^shinebright\.marryartstyle\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^shinebrightyoga\.com$ [NC]
RewriteRule ^ https://www.shinebrightyoga.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^media/(.+)$ media.php?file=$1 [QSA,L]

RewriteRule ^(classes|events|products)/([^/]+)/?$ detail.php?section=$1&id=$2 [QSA,L]
